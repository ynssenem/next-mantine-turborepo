{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "style": "./dist/index.css"
    },
    "./styles": "./dist/index.css",
    "./dist/index.css": "./dist/index.css",
    "./*": {
      "import": "./dist/components/*/index.mjs",
      "require": "./dist/components/*/index.js",
      "types": "./dist/components/*/index.d.ts",
      "style": "./dist/components/*/index.css"
    },
    "./postcss-config": {
      "import": "./dist/configs/postcss.mjs",
      "require": "./dist/configs/postcss.js"
    },
    "./theme": {
      "import": "./dist/configs/theme.mjs",
      "require": "./dist/configs/theme.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/css-modules": "^1.0.5",
    "@types/node": "catalog:nodejs",
    "@types/react": "catalog:nodejs",
    "@types/react-dom": "catalog:nodejs",
    "autoprefixer": "catalog:postcss",
    "esbuild-postcss": "^0.0.4",
    "postcss": "catalog:postcss",
    "postcss-preset-mantine": "catalog:postcss",
    "postcss-simple-vars": "catalog:postcss",
    "tsup": "catalog:nodejs",
    "typescript": "catalog:nodejs"
  },
  "peerDependencies": {
    "@mantine/carousel": "catalog:mantine",
    "@mantine/charts": "catalog:mantine",
    "@mantine/code-highlight": "catalog:mantine",
    "@mantine/core": "catalog:mantine",
    "@mantine/dates": "catalog:mantine",
    "@mantine/dropzone": "catalog:mantine",
    "@mantine/form": "catalog:mantine",
    "@mantine/hooks": "catalog:mantine",
    "@mantine/modals": "catalog:mantine",
    "@mantine/notifications": "catalog:mantine",
    "@mantine/nprogress": "catalog:mantine",
    "@mantine/spotlight": "catalog:mantine",
    "@mantine/tiptap": "catalog:mantine",
    "@tiptap/extension-link": "catalog:tiptap",
    "@tiptap/pm": "catalog:tiptap",
    "@tiptap/react": "catalog:tiptap",
    "@tiptap/starter-kit": "catalog:tiptap",
    "dayjs": "catalog:",
    "embla-carousel-react": "catalog:",
    "react": "catalog:nextjs",
    "react-dom": "catalog:nextjs",
    "recharts": "catalog:"
  }
}
